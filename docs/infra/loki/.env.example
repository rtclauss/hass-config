# Copy to ~/loki/.env on the infra server and fill in the real address.
# Do not commit the filled-in .env.
#
# LOKI_BIND_ADDR is the single host interface Loki's unauthenticated API is
# published on (auth_enabled: false in loki-config.yaml). Use the infra server's
# LAN address — the one Promtail pushes to and Grafana queries. Never 0.0.0.0.
LOKI_BIND_ADDR=
