# The ground-floor Valetudo vacuum was replaced by the Dreame X40
# (vacuum.x40_ultra), which has no Valetudo map camera or segment sensors,
# so this Valetudo-specific stall monitor only covers the den and upstairs.

vacuum_stall_monitor_den:
  module: vacuum_stall_monitor
  class: VacuumStallMonitor
  vacuum_entity: vacuum.valetudo_den
  map_camera_entity: camera.valetudo_den_map_data
  area_sensor: sensor.valetudo_den_current_statistics_area
  segments_sensor: sensor.valetudo_den_map_segments
  friendly_name: Den Vacuum
  sample_interval_sec: 90
  history_size: 12
  stall_samples: 6
  notify_service: @@PRIVATE:appdaemon_notify_target_slash_03@@
  dashboard_url: /@@PRIVATE:owner_person_slug@@-new-mushroom/cleaning-v2

vacuum_stall_monitor_upstairs:
  module: vacuum_stall_monitor
  class: VacuumStallMonitor
  vacuum_entity: vacuum.valetudo_upstairs_vacuum
  map_camera_entity: camera.valetudo_upstairs_vacuum_map_data
  area_sensor: sensor.valetudo_upstairs_vacuum_current_statistics_area
  segments_sensor: sensor.valetudo_upstairs_vacuum_map_segments
  friendly_name: Upstairs Vacuum
  sample_interval_sec: 90
  history_size: 12
  stall_samples: 6
  notify_service: @@PRIVATE:appdaemon_notify_target_slash_03@@
  dashboard_url: /@@PRIVATE:owner_person_slug@@-new-mushroom/cleaning-v2
