# Home Assistant package for the Uplift standing desk.
# It coordinates desk presets with guest mode, trip mode, work-camera setup, and timed reset logic so the office returns to a known state automatically.

################################################################
## Packages / Desk
################################################################

################################################
## Customize
################################################

homeassistant:
  customize:
    ################################################
    ## Node Anchors
    ################################################

    package.node_anchors:
      customize: &customize
        package: "desk"

      expose: &expose
        <<: *customize
        haaska_hidden: false
        homebridge_hidden: false

    ################################################
    ## Automations
    ################################################

    automation.uplift_desk_policy:
      <<: *customize
      friendly_name: "Desk Policy"
      icon: mdi:desk

    ################################################
    ## Scripts
    ################################################

    script.uplift_desk_auto_move_max:
      <<: *customize
      friendly_name: "Desk Auto Move Max"

    script.uplift_desk_auto_move:
      <<: *customize
      friendly_name: "Desk Auto Move"

    script.uplift_desk_auto_move_preset_1:
      <<: *customize
      friendly_name: "Desk Auto Move Preset 1"

    script.uplift_desk_auto_move_preset_2:
      <<: *customize
      friendly_name: "Desk Auto Move Preset 2"

    script.uplift_desk_manual_move_max:
      <<: *customize
      friendly_name: "Desk Manual Move Max"

    script.uplift_desk_manual_move_min:
      <<: *customize
      friendly_name: "Desk Manual Move Min"

    script.uplift_desk_manual_move_preset_1:
      <<: *customize
      friendly_name: "Desk Manual Move Preset 1"

    script.uplift_desk_manual_move_preset_2:
      <<: *customize
      friendly_name: "Desk Manual Move Preset 2"

    script.uplift_desk_manual_stop:
      <<: *customize
      friendly_name: "Desk Manual Stop"

    ################################################
    ## Timer
    ################################################

    timer.uplift_desk_motion_window:
      <<: *customize
      friendly_name: "Desk Motion Window"
      icon: mdi:timer-sand

########################
# Automation
########################
automation:
  # One policy automation owns every automated desk move so the priority
  # order lives in one place: guest mode > trip mode > work camera >
  # presence and timed moves. Manual uplift_desk_manual_* scripts bypass it.
  - id: uplift_desk_policy
    alias: uplift_desk_policy
    description: >
      Automated Uplift desk moves in priority order. Guest mode always raises
      the desk to max. Trip mode raises it to max unless guest mode is on.
      With guest and trip mode off, the work camera moves it to preset 2. With
      the camera also off, leaving home, 6 PM, or a laptop asleep for 10
      minutes raise it to max; arriving home on a workday and the Monday 4 AM
      reset return it to preset 1.
    mode: queued
    max: 5
    trace:
      stored_traces: 50
    trigger:
      - trigger: state
        id: guest_mode
        entity_id: input_boolean.guest_mode
        to: "on"
      - trigger: state
        id: trip_mode
        entity_id: input_boolean.trip
        to: "on"
      - trigger: state
        id: work_camera
        entity_id: binary_sensor.f7m69c_5d3d6e76_camera_in_use
        to: "on"
      - trigger: state
        id: departed
        entity_id: person.@@PRIVATE:owner_person_slug@@
        to: "not_home"
      - trigger: zone
        id: departed
        entity_id: device_tracker.bayesian_@@PRIVATE:presence_person_slug@@_home
        zone: zone.home
        event: leave
      - trigger: state
        id: arrived
        entity_id: person.@@PRIVATE:owner_person_slug@@
        to: "home"
      - trigger: zone
        id: arrived
        entity_id: device_tracker.bayesian_@@PRIVATE:presence_person_slug@@_home
        zone: zone.home
        event: enter
      - trigger: time
        id: evening
        at: "18:00:00"
      - trigger: state
        id: evening
        entity_id: binary_sensor.f7m69c_5d3d6e76_active
        to: "off"
        for:
          minutes: 10
      - trigger: time
        id: monday_reset
        at: "04:00:00"
    action:
      - choose:
          - alias: "Guest mode: highest priority"
            conditions:
              - condition: trigger
                id: guest_mode
            sequence:
              - action: script.uplift_desk_auto_move_max
          - alias: "Trip mode unless guest mode"
            conditions:
              - condition: trigger
                id: trip_mode
              - condition: state
                entity_id: input_boolean.guest_mode
                state: "off"
            sequence:
              - action: script.uplift_desk_auto_move_max
          - alias: "Work camera unless guest or trip mode"
            conditions:
              - condition: trigger
                id: work_camera
              - condition: state
                entity_id:
                  - input_boolean.guest_mode
                  - input_boolean.trip
                state: "off"
            sequence:
              - action: script.uplift_desk_auto_move_preset_2
          - alias: "Presence and timed moves: no higher-priority mode active"
            conditions:
              - condition: trigger
                id:
                  - departed
                  - arrived
                  - evening
                  - monday_reset
              - condition: state
                entity_id:
                  - input_boolean.guest_mode
                  - input_boolean.trip
                  - binary_sensor.f7m69c_5d3d6e76_camera_in_use
                state: "off"
            sequence:
              - choose:
                  - alias: "Left home (person and zone agree)"
                    conditions:
                      - condition: trigger
                        id: departed
                      - condition: state
                        entity_id: person.@@PRIVATE:owner_person_slug@@
                        state: "not_home"
                      - condition: not
                        conditions:
                          - condition: zone
                            entity_id: device_tracker.bayesian_@@PRIVATE:presence_person_slug@@_home
                            zone: zone.home
                    sequence:
                      - action: script.uplift_desk_auto_move_max
                  - alias: "Workday arrival (weekends stay raised until the Monday reset)"
                    conditions:
                      - condition: trigger
                        id: arrived
                      - condition: state
                        entity_id: binary_sensor.workday_sensor
                        state: "on"
                      - condition: state
                        entity_id: person.@@PRIVATE:owner_person_slug@@
                        state: "home"
                      - condition: zone
                        entity_id: device_tracker.bayesian_@@PRIVATE:presence_person_slug@@_home
                        zone: zone.home
                    sequence:
                      - action: script.uplift_desk_auto_move_preset_1
                  - alias: "6 PM or laptop asleep"
                    conditions:
                      - condition: trigger
                        id: evening
                    sequence:
                      - action: script.uplift_desk_auto_move_max
                  - alias: "Monday 4 AM reset"
                    conditions:
                      - condition: trigger
                        id: monday_reset
                      - condition: time
                        weekday:
                          - mon
                    sequence:
                      - action: script.uplift_desk_auto_move_preset_1

########################
# Script
########################
script:
  uplift_desk_auto_move:
    alias: uplift_desk_auto_move
    description: >
      Shared automation-only guard that sends the desk to a requested native
      Uplift button target when no other automated desk motion is in progress.
    mode: single
    trace:
      stored_traces: 10
    fields:
      target_button:
        name: Target button
        required: false
        selector:
          entity:
            domain: button
      height_limit:
        name: Height limit
        selector:
          select:
            options:
              - max
              - min
    sequence:
      - condition: state
        entity_id: timer.uplift_desk_motion_window
        state: "idle"
      - choose:
          - conditions: "{{ height_limit is defined }}"
            sequence:
              - action: script.uplift_desk_move_to_limit
                data:
                  height_limit: "{{ height_limit }}"
        default:
          - action: button.press
            target:
              entity_id: "{{ target_button }}"
      - action: timer.start
        target:
          entity_id: timer.uplift_desk_motion_window

  uplift_desk_auto_move_max:
    alias: uplift_desk_auto_move_max
    description: >
      Automation-only wrapper that sends the desk to the configured maximum
      height when no other automated desk motion is already in progress.
    mode: single
    trace:
      stored_traces: 10
    sequence:
      - action: script.uplift_desk_auto_move
        data:
          height_limit: max

  uplift_desk_auto_move_preset_1:
    alias: uplift_desk_auto_move_preset_1
    description: >
      Automation-only wrapper that sends the desk to preset 1 when no other
      automated desk motion is already in progress.
    mode: single
    trace:
      stored_traces: 10
    sequence:
      - action: script.uplift_desk_auto_move
        data:
          target_button: button.uplift_desk_75b205_move_to_preset_1

  uplift_desk_auto_move_preset_2:
    alias: uplift_desk_auto_move_preset_2
    description: >
      Automation-only wrapper that sends the desk to preset 2 when no other
      automated desk motion is already in progress.
    mode: single
    trace:
      stored_traces: 10
    sequence:
      - action: script.uplift_desk_auto_move
        data:
          target_button: button.uplift_desk_75b205_move_to_preset_2

  uplift_desk_manual_move_max:
    alias: uplift_desk_manual_move_max
    description: >
      Manual desk control for dashboards and UI buttons. This bypasses the
      Home Assistant automation guard and sends the desk to the configured
      maximum height immediately.
    mode: single
    icon: mdi:arrow-up-bold-box
    trace:
      stored_traces: 10
    sequence:
      - action: script.uplift_desk_move_to_limit
        data:
          height_limit: max

  uplift_desk_manual_move_min:
    alias: uplift_desk_manual_move_min
    description: >
      Manual desk control for dashboards and UI buttons. This bypasses the
      Home Assistant automation guard and sends the desk to the configured
      minimum height immediately.
    mode: single
    icon: mdi:arrow-down-bold-box
    trace:
      stored_traces: 10
    sequence:
      - action: script.uplift_desk_move_to_limit
        data:
          height_limit: min

  uplift_desk_move_to_limit:
    alias: Desk Move to Height Limit
    description: "Drive the Uplift desk to a requested height limit through its height setpoint number entity."
    mode: single
    trace:
      stored_traces: 10
    fields:
      height_limit:
        required: true
        selector:
          select:
            options:
              - max
              - min
    sequence:
      # User-confirmed keypad limits: 25.3 and 50.9 inches, rounded to mm.
      - variables:
          target_mm: "{{ 1293 if height_limit == 'max' else 643 }}"
      - condition: template
        value_template: >-
          {{ height_limit in ['min', 'max'] and
             states('number.uplift_desk_75b205_height_setpoint') != 'unavailable' and
             state_attr('number.uplift_desk_75b205_height_setpoint', 'min') is number and
             state_attr('number.uplift_desk_75b205_height_setpoint', 'max') is number and
             state_attr('number.uplift_desk_75b205_height_setpoint', 'min') <= target_mm | int <=
             state_attr('number.uplift_desk_75b205_height_setpoint', 'max') }}
      - action: number.set_value
        target:
          entity_id: number.uplift_desk_75b205_height_setpoint
        data:
          value: "{{ target_mm }}"

  uplift_desk_manual_move_preset_1:
    alias: uplift_desk_manual_move_preset_1
    description: >
      Manual desk control for dashboards and UI buttons. This bypasses the
      Home Assistant automation guard and sends the desk to preset 1.
    mode: single
    icon: mdi:numeric-1-box
    trace:
      stored_traces: 10
    sequence:
      - action: button.press
        target:
          entity_id: button.uplift_desk_75b205_move_to_preset_1

  uplift_desk_manual_move_preset_2:
    alias: uplift_desk_manual_move_preset_2
    description: >
      Manual desk control for dashboards and UI buttons. This bypasses the
      Home Assistant automation guard and sends the desk to preset 2.
    mode: single
    icon: mdi:numeric-2-box
    trace:
      stored_traces: 10
    sequence:
      - action: button.press
        target:
          entity_id: button.uplift_desk_75b205_move_to_preset_2

  uplift_desk_manual_stop:
    alias: uplift_desk_manual_stop
    description: >
      Manual desk control for dashboards and UI buttons. This bypasses the
      Home Assistant automation guard and stops desk motion immediately.
    mode: single
    icon: mdi:stop-circle
    trace:
      stored_traces: 10
    sequence:
      - action: button.press
        target:
          entity_id: button.uplift_desk_75b205_stop

########################
# Timer
########################
timer:
  uplift_desk_motion_window:
    duration: "00:00:45"
