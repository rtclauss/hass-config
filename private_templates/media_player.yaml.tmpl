              enqueue: replace

  music_assistant_prime_wake_group:
    alias: "Prime exact wake-up MA Sonos group"
    trace:
      stored_traces: 10
    mode: queued
    fields:
      group_members:
        description: "Exact MA Sonos wake-up members to group and prime"
      starting_volume:
        description: "Initial per-member volume before playback starts"
    sequence:
      # Evict any stray member left in the live bedroom sync group from a
      # prior grouping (e.g. Tiki Room after whole-home / arrival audio) —
      # media_player.join below ADDS the intended followers but never removes
      # extras, so without this a stray room stays in the group unprimed and
      # unramped, playing owner-suite wake-up audio at whatever volume it was
      # left at. docs/music_assistant.md requires Tiki Room stay out of
      # wake-up audio; this makes the group exactly group_members.
      - alias: "Unjoin any stray members not in the intended wake-up group"
        variables:
          stray_members: >-
            {{ (state_attr('media_player.ma_bedroom', 'group_members') or [])
               | reject('in', group_members) | list }}
      - if:
          - condition: template
            value_template: "{{ stray_members | count > 0 }}"
        then:
          - continue_on_error: true
            action: media_player.unjoin
            target:
              entity_id: "{{ stray_members }}"
      - alias: "Set each wake-up member to the starting volume"
        continue_on_error: true
        action: media_player.volume_set
        target:
          entity_id: "{{ group_members }}"
        data:
          volume_level: "{{ starting_volume | float(0.01) }}"
      - alias: "Prepare exact wake-up group from MA Sonos players"
        continue_on_error: true
        action: media_player.join
        target:
          entity_id: media_player.ma_bedroom
        data:
          group_members: "{{ group_members | reject('eq', 'media_player.ma_bedroom') | list }}"

  music_assistant_radio_wake_up:
    alias: "Radio wake-up via Music Assistant"
    trace:
      stored_traces: 50
    fields:
      radio_uri:
        description: "Music Assistant radio URI"
      initial_delay:
        description: "Optional delay before playback starts"
      ramp_step_volume:
        description: "volume_level increment per ramp update (default 0.01 = 1 percentage point ≈ 0.5 dB at the assumed 50 dB Sonos/MA range — half the ~1 dB just-noticeable-difference, same per-step size as the bedtime rampdown)"
      ramp_interval_seconds:
        description: "Seconds between ramp updates (default 15). At the default step size this yields ~6 minutes from silence to the peak — stretched well past the ~4s auditory-echoic-memory window so the rise reads as smooth rather than a series of audible jumps"
      ramp_peak_volume_level:
        description: "Target volume_level for non-office, non-bedroom wake-up members (default 0.25)"
      ramp_bedroom_peak_volume_level:
        description: "Target volume_level for the bedroom member, set higher than the other rooms so the sleeper is reliably woken (default 0.30)"
      ramp_office_peak_volume_level:
        description: "Target volume_level for the office member, capped lower so the wake-up does not disturb work-in-progress (default 0.07)"
      playback_entity_id:
        description: "Preferred Music Assistant player for wake-up playback (kept for backwards compatibility; ignored — sync group is used)"
      regroup_after_play:
        description: "Kept for backwards compatibility; ignored — sync groups manage membership"
      fallback_uri:
        description: "Provider-independent source to play if the primary radio source cannot be resolved (e.g. a TuneIn/DNS outage). Accepts a raw http(s) stream URL (played via media_player.play_media) or a Music Assistant URI such as spotify:/library:/tunein-- (played via music_assistant.play_media). Default: a Spotify morning playlist that does not depend on the TuneIn resolver."
      fallback_media_type:
        description: "media_type for a Music Assistant fallback_uri (default: playlist); ignored for raw http(s) stream URLs"
      verify_timeout:
        description: "Seconds to wait for playback to be confirmed at each attempt (default: 20)"
      retry_backoff:
        description: "Seconds to wait before retrying the primary source once (default: 15)"
    variables:
      playback_player: media_player.ma_bedroom
      effective_interval_seconds: "{{ ramp_interval_seconds | default(15) | int(15) }}"
      effective_peak_volume: "{{ ramp_peak_volume_level | default(0.25) | float(0.25) }}"
      # The bedroom peaks higher than the other rooms — it holds the sleeper,
      # so the wake-up has to clear the "still asleep" threshold there, not
      # just be audible. Other rooms stay at effective_peak_volume.
      effective_bedroom_peak_volume: "{{ ramp_bedroom_peak_volume_level | default(0.30) | float(0.30) }}"
      # Clamped to the alarm spec's office_wakeup_peak_volume_percent (7%)
      # as a ceiling, not just a default — the spec requires the office
      # capped there so the wake-up never disturbs work-in-progress; a
      # caller can still ask for something quieter, never louder.
      effective_office_peak_volume: >-
        {{ [(ramp_office_peak_volume_level | default(0.07) | float(0.07)), 0.07] | min }}
      # Non-positive values snap up to the documented 0.01 default; any
      # positive-but-too-small value (e.g. an explicit 0.001) snaps up to
      # min_step_volume_for_watchdog instead. Jinja's default() filter only
      # substitutes for an *undefined* input, not an explicitly-passed value,
      # so either case would otherwise let the ramp take arbitrarily long to
      # reach effective_peak_volume — recover_stuck_morning_audio_scripts
      # (media_player.yaml:509-526) force-stops this script at 12 minutes
      # regardless, so a too-small step leaves the wake-up stuck partway
      # instead of ever reaching peak. min_step_volume_for_watchdog is
      # derived from the *configured* peak/interval (not a fixed constant)
      # so it stays correct if a caller changes those too, and targets
      # completing within a 10-minute budget — comfortably inside the
      # watchdog's 12 minutes.
      effective_step_volume: >-
        {% set raw_step_volume = ramp_step_volume | default(0.01) | float(0.01) %}
        {% set positive_step_volume = raw_step_volume if raw_step_volume > 0 else 0.01 %}
        {% set watchdog_timeout_seconds = 720 %}
        {% set watchdog_safety_margin_seconds = 120 %}
        {% set max_ramp_distance = [effective_peak_volume, effective_bedroom_peak_volume, effective_office_peak_volume] | max %}
        {% set min_step_volume_for_watchdog = (max_ramp_distance * effective_interval_seconds) / (watchdog_timeout_seconds - watchdog_safety_margin_seconds) %}
        {{ [positive_step_volume, min_step_volume_for_watchdog] | max }}
      # Safety bound so a stuck/unavailable player can never hold the ramp
      # open indefinitely (the theoretical step count, plus margin).
      effective_max_ramp_iterations: >-
        {{ (([effective_peak_volume, effective_bedroom_peak_volume, effective_office_peak_volume] | max) / effective_step_volume) | round(0, 'ceil') + 10 }}
      effective_fallback_uri: >-
        {{ fallback_uri | default('@@PRIVATE:music_uri_021@@', true) }}
      effective_fallback_media_type: "{{ fallback_media_type | default('playlist', true) }}"
      effective_verify_timeout: "{{ verify_timeout | default(20) | int(20) }}"
      effective_retry_backoff: "{{ retry_backoff | default(15) | int(15) }}"
      group_members: >-
        {{ ['media_player.ma_bedroom', 'media_player.ma_bathroom']
           if is_state('input_boolean.guest_mode', 'on')
           else ['media_player.ma_bedroom', 'media_player.ma_bathroom',
                 'media_player.ma_office', 'media_player.ma_den'] }}
      pre_playback_fingerprint: >-
        {{ [
          state_attr(playback_player, 'media_content_id') | default('', true),
          state_attr(playback_player, 'media_title') | default('', true),
          state_attr(playback_player, 'media_artist') | default('', true),
          state_attr(playback_player, 'media_album_name') | default('', true)
        ] | join('|') }}
    sequence:
      - alias: "Prime the exact wake-up group to 0.01"
        action: script.music_assistant_prime_wake_group
        data:
          group_members: "{{ group_members }}"
          starting_volume: 0.01
      - if:
          - condition: template
            value_template: "{{ (initial_delay | default(0) | int(0)) > 0 }}"
        then:
          - delay:
              seconds: "{{ initial_delay | default(0) | int(0) }}"
      - alias: "Request the primary wake-up source"
        action: script.music_assistant_play_wakeup_source
        continue_on_error: true
        data:
          target_entity: "{{ playback_player }}"
          source_uri: "{{ radio_uri }}"
          source_media_type: radio
      # Verify the source actually started before fading anything up. The group
      # may already hold overnight audio at alarm time, and a source-resolution
      # failure (e.g. a DNS flap reaching opml.radiotime.com) leaves the group
      # idle/silent — so "is it playing?" alone is not proof. Confirmation =
      # `playing` AND the media changed from the pre-request fingerprint. All
      # wait/decision steps stay at the top sequence level so `wait.completed`
      # is read in the same scope it is set (HA copies variables into nested
      # then/choose sub-scripts, so a value set inside `then:` is not visible
      # to a later top-level step).
      - alias: "Confirm primary playback started"
        wait_template: >-
          {{ is_state(playback_player, 'playing') and [
              state_attr(playback_player, 'media_content_id') | default('', true),
              state_attr(playback_player, 'media_title') | default('', true),
              state_attr(playback_player, 'media_artist') | default('', true),
              state_attr(playback_player, 'media_album_name') | default('', true)
            ] | join('|') != pre_playback_fingerprint }}
        timeout:
          seconds: "{{ effective_verify_timeout }}"
        continue_on_timeout: true
      - alias: "Retry the primary source once after a short backoff (transient DNS)"
        if:
          - condition: template
            value_template: "{{ not wait.completed }}"
        then:
          - delay:
              seconds: "{{ effective_retry_backoff }}"
          - action: script.music_assistant_play_wakeup_source
            continue_on_error: true
            data:
              target_entity: "{{ playback_player }}"
              source_uri: "{{ radio_uri }}"
              source_media_type: radio
      - alias: "Confirm playback after the retry"
        wait_template: >-
          {{ is_state(playback_player, 'playing') and [
              state_attr(playback_player, 'media_content_id') | default('', true),
              state_attr(playback_player, 'media_title') | default('', true),
              state_attr(playback_player, 'media_artist') | default('', true),
              state_attr(playback_player, 'media_album_name') | default('', true)
            ] | join('|') != pre_playback_fingerprint }}
        timeout:
          seconds: "{{ effective_verify_timeout }}"
        continue_on_timeout: true
      - alias: "Fall back to a provider-independent source so the alarm still sounds"
        if:
          - condition: template
            value_template: "{{ not wait.completed and (effective_fallback_uri | length) > 0 }}"
        then:
          - action: persistent_notification.create
            data:
              notification_id: wakeup_radio_primary_failed
              title: "Wake-up radio fell back"
              message: >-
                Primary wake-up source {{ radio_uri }} could not be started on
                {{ playback_player }}; falling back to {{ effective_fallback_uri }}.
          - action: script.music_assistant_play_wakeup_source
            continue_on_error: true
            data:
              target_entity: "{{ playback_player }}"
              source_uri: "{{ effective_fallback_uri }}"
              source_media_type: "{{ effective_fallback_media_type }}"
      - alias: "Confirm playback after the fallback"
        wait_template: >-
          {{ is_state(playback_player, 'playing') and [
              state_attr(playback_player, 'media_content_id') | default('', true),
              state_attr(playback_player, 'media_title') | default('', true),
              state_attr(playback_player, 'media_artist') | default('', true),
              state_attr(playback_player, 'media_album_name') | default('', true)
            ] | join('|') != pre_playback_fingerprint }}
        timeout:
          seconds: "{{ effective_verify_timeout }}"
        continue_on_timeout: true
      - alias: "Give up loudly — never fade up a silent group (issue #772)"
        if:
          - condition: template
            value_template: "{{ not wait.completed }}"
        then:
          - action: persistent_notification.create
            data:
              notification_id: wakeup_radio_failed
              title: "Wake-up audio failed"
              message: >-
                Neither the primary source ({{ radio_uri }}) nor the fallback
                ({{ effective_fallback_uri }}) started on {{ playback_player }}.
                Skipped the volume ramp.
          - action: logbook.log
            data:
              entity_id: script.music_assistant_radio_wake_up
              domain: script
              name: Radio wake-up via Music Assistant
              message: "Wake-up audio playback could not be established; skipped volume ramp."
          - stop: "Wake-up audio playback could not be established; skipped volume ramp."
            error: true
      # Perceptual design: each update raises volume by effective_step_volume
      # (default 0.01 ≈ 0.5 dB, half the ~1 dB just-noticeable-difference) and
      # waits effective_interval_seconds (default 15s, well past the ~4s
      # echoic-memory window) so the climb reads as smooth rather than as
      # discrete jumps. Every group member (office included, when present) is
      # commanded to an ABSOLUTE, index-driven target — effective_step_volume ×
      # the outer iteration count, capped at that member's peak — NOT its own
      # live volume_level + a step. This is deliberate: MA/Sonos group volume
      # "proportional scaling rounds to 0 below ~8%" (docs/music_assistant.md),
      # so a readback-derived target (min(live + step, peak)) gets trapped in
      # that sub-8% dead zone — the reported volume stops rising, so the next
      # target never advances past live+step and the ramp stalls at ~6% (the
      # 2026-08-12 MPR alarm). An absolute curve keeps raising the COMMANDED
      # value (0.08, 0.15, 0.25…) regardless of a pinned readback, powering
      # straight through the dead zone — the same technique the working
      # owner_suite_morning_transition ramp already uses. Each member resolves
      # its own peak: the bedroom to effective_bedroom_peak_volume (higher, to
      # wake the sleeper), the office to effective_office_peak_volume (capped),
      # everyone else to effective_peak_volume. Priming set every member to the
      # starting volume, so the curve is authoritative from index 1. Guest mode
      # excluding the office from group_members means it's simply never iterated
      # — no special-casing needed. Completion is index-driven (steps_to_peak =
      # ceil(loudest peak / step)), so a stale/pinned volume_level can neither
      # stall the loop nor extend it; effective_max_ramp_iterations remains a
      # hard backstop. continue_on_error keeps one unavailable member from
      # aborting the rest of the ramp.
      - repeat:
          while:
            - condition: template
              value_template: >-
                {% set max_member_peak = [effective_peak_volume, effective_bedroom_peak_volume, effective_office_peak_volume] | max %}
                {% set steps_to_peak = (max_member_peak / effective_step_volume) | round(0, 'ceil') %}
                {{ repeat.index <= steps_to_peak and repeat.index <= effective_max_ramp_iterations }}
          sequence:
            # Capture the OUTER iteration count before descending into the
            # per-member for_each, whose own repeat.index would otherwise
            # shadow it (inner index = position within group_members).
            - variables:
                ramp_index: "{{ repeat.index }}"
            - repeat:
                for_each: "{{ group_members }}"
                sequence:
                  - action: media_player.volume_set
                    continue_on_error: true
                    target:
                      entity_id: "{{ repeat.item }}"
                    data:
                      # Absolute curve = step × iteration, capped at the peak.
                      # A member that was unavailable for part of the fade
                      # (missed volume_set calls under continue_on_error) snaps
                      # to the elapsed curve position when it returns, rather
                      # than fading up from where it dropped. For a wake-up
                      # ALARM that catch-up is intended: every room must reach
                      # its peak to wake the sleeper, so a briefly-offline room
                      # rejoining the group level is correct — leaving it quiet,
                      # or dropping it from the run, risks not waking someone.
                      # A readback-relative cap would smooth the catch-up but
                      # reintroduce the sub-8% dead-zone stall this ramp exists
                      # to defeat (a pinned member is indistinguishable from a
                      # recovering one without per-member history, which HA
                      # templates can't carry across iterations). Matches the
                      # in-production owner_suite_morning_transition ramp.
                      volume_level: >-
                        {% set member_peak = {'media_player.ma_office': effective_office_peak_volume, 'media_player.ma_bedroom': effective_bedroom_peak_volume}.get(repeat.item, effective_peak_volume) %}
                        {{ [effective_step_volume * ramp_index, member_peak] | min }}
            - delay:
                seconds: "{{ effective_interval_seconds }}"

