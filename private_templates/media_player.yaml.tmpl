              "@@PRIVATE:media_stream_003@@",
              "@@PRIVATE:media_stream_004@@",
              "@@PRIVATE:media_stream_005@@",
              "@@PRIVATE:music_uri_014@@"
              ] -%}
            {% set pindex = (range(0, (plists | length))|random) -%}
            {{ plists[pindex] }}
      - variables:
          bedtime_playback_entity: >-
            {{ 'media_player.ma_group_guest' if is_state('input_boolean.guest_mode', 'on')
               else 'media_player.ma_group_everywhere' }}
          bedtime_media_type: "{{ 'radio' if 'somafm.com' in playlist else '' }}"
          bedtime_apple_music_fallback_uri: "@@PRIVATE:media_apple_music_fallback@@"
          bedtime_apple_music_fallback_media_type: ""
          bedtime_local_library_fallback_uri: "@@PRIVATE:media_local_radio_fallback@@"
          bedtime_local_library_fallback_media_type: radio
          bedtime_pre_playback_fingerprint: >-
            {{ [
              state_attr(bedtime_playback_entity, 'media_content_id') | default('', true),
              state_attr(bedtime_playback_entity, 'media_title') | default('', true),
              state_attr(bedtime_playback_entity, 'media_artist') | default('', true),
              state_attr(bedtime_playback_entity, 'media_album_name') | default('', true)
            ] | join('|') }}
      - action: media_player.shuffle_set
        continue_on_error: true
        target:
          entity_id: "{{ bedtime_playback_entity }}"
        data:
          shuffle: >-
            {%- set shuffle = [true, false] -%}
            {% set sindex =  (range(0, (shuffle | length))|random) -%}
            {{ shuffle[sindex] }}
      - action: media_player.repeat_set
        continue_on_error: true
        data:
          repeat: all
        target:
          entity_id: "{{ bedtime_playback_entity }}"
      - alias: "Let bedtime repeat mode settle before volume changes"
        delay:
          seconds: 2
      - action: media_player.volume_set
        continue_on_error: true
        target:
          entity_id:
            - media_player.ma_bedroom
            - media_player.ma_bathroom
            - media_player.ma_office
            - media_player.ma_den
        data:
          volume_level: 0.20
      - alias: "Let bedtime volume settle before playback starts"
        delay:
          seconds: 2
      - action: logbook.log
        data:
          entity_id: "{{ bedtime_playback_entity }}"
          domain: media_player
          name: Spotify Bedtime is
          message: " playing Bedtime playlist: {{ playlist }}"
      - alias: "Play bedtime music on sync group"
        action: script.music_assistant_play_item
        data:
          entity_id: "{{ bedtime_playback_entity }}"
          media_item: "{{ playlist }}"
          media_type: "{{ bedtime_media_type }}"
      - alias: "Confirm primary bedtime playback changed the group media"
        wait_template: >-
          {{ is_state(bedtime_playback_entity, 'playing') and [
              state_attr(bedtime_playback_entity, 'media_content_id') | default('', true),
              state_attr(bedtime_playback_entity, 'media_title') | default('', true),
              state_attr(bedtime_playback_entity, 'media_artist') | default('', true),
              state_attr(bedtime_playback_entity, 'media_album_name') | default('', true)
            ] | join('|') != bedtime_pre_playback_fingerprint }}
        timeout:
          seconds: 15
        continue_on_timeout: true
      - if:
          - condition: template
            value_template: "{{ not wait.completed }}"
        then:
          - action: logbook.log
            data:
              entity_id: "{{ bedtime_playback_entity }}"
              domain: media_player
              name: Spotify Bedtime fallback is
              message: " primary bedtime playback failed to start; playing LoFi fallback"
          - action: script.music_assistant_play_random_lofi_playlist
            data:
              entity_id: "{{ bedtime_playback_entity }}"
              playlist_name: Bedtime LoFi fallback
              log_name: Spotify Bedtime fallback is
      - alias: "Confirm LoFi fallback changed the group media"
        wait_template: >-
          {{ is_state(bedtime_playback_entity, 'playing') and [
              state_attr(bedtime_playback_entity, 'media_content_id') | default('', true),
              state_attr(bedtime_playback_entity, 'media_title') | default('', true),
              state_attr(bedtime_playback_entity, 'media_artist') | default('', true),
              state_attr(bedtime_playback_entity, 'media_album_name') | default('', true)
            ] | join('|') != bedtime_pre_playback_fingerprint }}
        timeout:
          seconds: 15
        continue_on_timeout: true
      - if:
          - condition: template
            value_template: "{{ not wait.completed }}"
        then:
          - action: logbook.log
            data:
              entity_id: "{{ bedtime_playback_entity }}"
              domain: media_player
              name: Apple Music bedtime fallback is
              message: >-
                Spotify bedtime and LoFi fallback failed; playing Apple Music
                fallback: {{ bedtime_apple_music_fallback_uri }}
          - action: script.music_assistant_play_item
            data:
              entity_id: "{{ bedtime_playback_entity }}"
              media_item: "{{ bedtime_apple_music_fallback_uri }}"
              media_type: "{{ bedtime_apple_music_fallback_media_type }}"
      - alias: "Confirm Apple Music fallback changed the group media"
        wait_template: >-
          {% set ns = namespace(parts=[]) %}
          {% for attr in [
            'media_content_id',
            'media_title',
            'media_artist',
            'media_album_name'
          ] %}
            {% set value =
              state_attr(bedtime_playback_entity, attr)
              | default('', true)
            %}
            {% set ns.parts = ns.parts + [value] %}
          {% endfor %}
          {{ is_state(bedtime_playback_entity, 'playing')
             and ns.parts | join('|') != bedtime_pre_playback_fingerprint }}
        timeout:
          seconds: 15
        continue_on_timeout: true
      - if:
          - condition: template
            value_template: "{{ not wait.completed }}"
        then:
          - action: logbook.log
            data:
              entity_id: "{{ bedtime_playback_entity }}"
              domain: media_player
              name: Local bedtime fallback is
              message: >-
                Apple Music bedtime fallback failed; playing local library
                fallback: {{ bedtime_local_library_fallback_uri }}
          - action: script.music_assistant_play_item
            data:
              entity_id: "{{ bedtime_playback_entity }}"
              media_item: "{{ bedtime_local_library_fallback_uri }}"
              media_type: "{{ bedtime_local_library_fallback_media_type }}"
      - alias: "Confirm local library fallback changed the group media"
        wait_template: >-
          {% set ns = namespace(parts=[]) %}
          {% for attr in [
            'media_content_id',
            'media_title',
            'media_artist',
            'media_album_name'
          ] %}
            {% set value =
              state_attr(bedtime_playback_entity, attr)
              | default('', true)
            %}
            {% set ns.parts = ns.parts + [value] %}
          {% endfor %}
          {{ is_state(bedtime_playback_entity, 'playing')
             and ns.parts | join('|') != bedtime_pre_playback_fingerprint }}
        timeout:
          seconds: 15
        continue_on_timeout: true
      - if:
          - condition: template
            value_template: "{{ not wait.completed }}"
        then:
          - action: persistent_notification.create
            data:
              notification_id: bedtime_audio_failed
              title: "Bedtime audio failed"
              message: >-
                Spotify bedtime, LoFi, Apple Music, and local library fallbacks
                all failed to start on {{ bedtime_playback_entity }}.
      - alias: "Ensure bedtime queue repeats after playback starts"
        action: media_player.repeat_set
        continue_on_error: true
        data:
          repeat: all
        target:
          entity_id: "{{ bedtime_playback_entity }}"
      - wait_for_trigger:
          - trigger: state
            entity_id: binary_sensor.owner_suite_bathroom_room_occupancy
            to: "on"
        timeout:
          minutes: 10 # TODO this as a variable that is passed by the caller. Different timeouts for tv off and for laying in bed automation
        continue_on_timeout: true
      - if:
          - condition: template
            value_template: "{{ wait.completed }}"
        then:
          - delay:
              minutes: 3
      - action: script.turn_on
        target:
          entity_id: script.spotify_bedtime_volume

  spotify_bedtime_volume:
    alias: "Spotify Bedtime Rampdown"
    trace:
      stored_traces: 50
    sequence:
      - variables:
          # Perceptual design: each update lowers volume by
          # bedtime_rampdown_step_volume (0.01 ≈ 0.5 dB at the assumed 50 dB
          # Sonos/MA range — half the ~1 dB just-noticeable-difference), then
          # waits bedtime_rampdown_interval_seconds (12s, 3x the ~4s
          # auditory-echoic-memory window) so no single step is ever compared
          # against a fresh reference. Reads live volume each iteration
          # (rather than a precomputed curve) so a manually raised/lowered
          # room still tapers smoothly, and a dropped/unavailable member
          # (continue_on_error, #839) never desyncs the rest of the ramp.
          # Bedroom alone keeps a higher 6% floor: MA proportional scaling
          # rounds lower bedroom levels too aggressively after the loudness
          # change. Office, bathroom, and den all ramp down to 1%. Office and
          # den are guest_capable_rooms per docs/room_intent.yaml
          # ("override_when_guest_present: treat as guest-private room at any
          # time", priority high) — the same rooms the wake-up scripts'
          # group_members already exclude in guest mode. guest_mode is
          # re-checked live every iteration (not snapshotted once up front),
          # so a room stops being touched within one interval of guest mode
          # turning on mid-rampdown, not just at script start. This script
          # has callers with no guest-mode guard of their own (e.g.
          # bed_without_prep), so the exclusion lives here rather than
          # relying on every caller to remember it.
          bedtime_rampdown_step_volume: 0.01
          bedtime_rampdown_interval_seconds: 12
          bedtime_rampdown_targets:
            - entity_id: media_player.ma_bedroom
              floor_volume: 0.06
              guest_capable: false
            - entity_id: media_player.ma_bathroom
              floor_volume: 0.01
              guest_capable: false
            - entity_id: media_player.ma_office
              floor_volume: 0.01
              guest_capable: true
            - entity_id: media_player.ma_den
              floor_volume: 0.01
              guest_capable: true
          # Safety bound so a member stuck reporting a stale above-floor
          # volume (e.g. volume_set silently failing under
          # continue_on_error) can't hold the rampdown open indefinitely —
          # the max possible distance (silence to full volume) at the
          # configured step size, plus margin.
          bedtime_rampdown_max_iterations: >-
            {{ (1 / bedtime_rampdown_step_volume) | round(0, 'ceil') + 10 }}
      # Unlike the wake-up ramp (which climbs an absolute index-driven curve
      # to power through MA's "rounds to 0 below ~8%" dead zone), this rampdown
      # steps DOWN from each target's OWN live volume every iteration:
      # max(live − step, floor). That is deliberate and NOT a stall risk here —
      # it descends toward a low floor (0.06 bedroom / 0.01 others), the regime
      # where the dead zone helps reach floor rather than trapping the climb.
      # A live-relative step is also the only pause-safe option: guest mode
      # skips office/den mid-rampdown (re-checked live each iteration), so an
      # absolute step × global-iteration curve would resume a paused room many
      # steps below where it was left, slamming it to floor in one jump. A room
      # unavailable at script start and later recovered is likewise handled for
      # free — it simply eases one step down from wherever it re-appears. HA
      # templates can't carry a per-target active-iteration counter across
      # outer iterations, so an absolute curve can't be made pause-aware here
      # (Codex review, PR #957).
      - repeat:
          while:
            - condition: template
              value_template: >-
                {% set ns = namespace(any_active_above_floor=false) %}
                {% set guest_mode_on = is_state('input_boolean.guest_mode', 'on') %}
                {% for target in bedtime_rampdown_targets %}
                  {% if not (guest_mode_on and target.guest_capable) %}
                    {% if (state_attr(target.entity_id, 'volume_level') | float(target.floor_volume)) > target.floor_volume %}
                      {% set ns.any_active_above_floor = true %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
                {{ repeat.index <= bedtime_rampdown_max_iterations and ns.any_active_above_floor }}
          sequence:
            - repeat:
                for_each: "{{ bedtime_rampdown_targets }}"
                sequence:
                  # Every step tolerates an unavailable member (e.g. a faulted
                  # bathroom Sonos, #839) so one dropped speaker never aborts
                  # the rampdown. Guest-capable targets are skipped whenever
                  # guest mode is currently on, checked fresh each iteration.
                  # Also skipped once a target's live volume is already at or
                  # below its floor — otherwise max(live - step, floor) would
                  # raise it back UP to floor on the next iteration (e.g.
                  # someone manually mutes a room mid-rampdown), which is
                  # backwards for a rampdown.
                  - if:
                      - condition: template
                        value_template: >-
                          {{ not (is_state('input_boolean.guest_mode', 'on') and repeat.item.guest_capable)
                             and (state_attr(repeat.item.entity_id, 'volume_level') | float(repeat.item.floor_volume)) > repeat.item.floor_volume }}
                    then:
                      - action: media_player.volume_set
                        continue_on_error: true
                        target:
                          entity_id: "{{ repeat.item.entity_id }}"
                        data:
                          # One step down from the target's OWN live volume,
                          # floored — self-correcting across pauses, manual
                          # changes, and unavailable→recovered transitions.
                          volume_level: >-
                            {{ [(state_attr(repeat.item.entity_id, 'volume_level') | float(repeat.item.floor_volume)) - bedtime_rampdown_step_volume, repeat.item.floor_volume] | max }}
            - delay:
                seconds: "{{ bedtime_rampdown_interval_seconds }}"

