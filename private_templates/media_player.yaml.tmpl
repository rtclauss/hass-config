########################
# Alarm Panel
########################
alarm_control_panel: []

########################
## Automation
########################
automation:
  - id: bedroom_music_volume
    alias: bedroom_music_volume
    trace:
      stored_traces: 50
    trigger:
      # - platform: event
      #   event_type: zha_event
      #   event_data:
@@PRIVATE:music_annotation_001@@
      #     command: "rotate_left"
      # - platform: event
      #   event_type: zha_event
      #   event_data:
@@PRIVATE:music_annotation_002@@
      #     command: "rotate_right"
      - trigger: state
        entity_id: sensor.owner_suite_cube_action_angle
        not_to:
          - None
          - "unknown"
          - "unavailable"
    action:
      - action: media_player.volume_set
        target:
          entity_id: media_player.ma_bedroom
        data:
          # volume_level: >-
          # {{ (state_attr('media_player.bedroom', 'volume_level') + trigger.event.data.args.relative_degrees/1000) | round(2) | float(default=0) }}
          # Fixed: the inner float() call now carries its own default of 0 so that
          # transient "unknown"/"unavailable" sensor states (e.g. cube waking up)
          # do not raise a ValueError and abort the automation.
          volume_level: >-
            {{ (state_attr('media_player.ma_bedroom', 'volume_level') + (float(trigger.to_state.state, 0)/1000)) | round(2) | float(default=0) }}

  - id: bedroom_music_play_pause
    alias: bedroom_music_play_pause
    trace:
      stored_traces: 50
    trigger:
      # - platform: event
      #   event_type: zha_event
      #   event_data:
@@PRIVATE:music_annotation_003@@
      #     command: "knock"
      - trigger: state
        entity_id: sensor.owner_suite_cube_action
        to: "tap"
    action:
      - action: media_player.media_play_pause
        target:
          entity_id: media_player.ma_bedroom

  - id: bed_without_prep
    alias: bed_without_prep
    # Trigger on the DEBOUNCED bed signal (binary_sensor.bed_occupied_debounced,
    # a 45s-delay_off view of binary_sensor.bayesian_bed_occupancy) rather than
    # the raw Bayesian sensor, which blips off for ~2s on every weight shift.
    # Those blips fired this automation repeatedly and, under the former
    # mode: single, dropped the settled trigger as failed_single so the music
    # rampdown never ran on the real "in bed" state. mode: restart lets a genuine
    # re-entry (out of bed and back in) supersede a stale run.
    mode: restart
    trace:
      stored_traces: 50
    trigger:
      - trigger: state
        entity_id: binary_sensor.bed_occupied_debounced
        to: "on"
    condition:
      - and:
          - condition: time
            after: "22:00:00"
            before: "06:00:00"
          - condition: numeric_state
            entity_id: media_player.ma_bedroom
            attribute: "volume_level"
            above: 0.01
          - condition: state
            entity_id:
              - media_player.ma_bedroom
            state: "playing"
    action:
      # Run all three concurrently so the ~77s owner-suite LED policy can never
      # delay the music rampdown. Previously the blocking LED call sat in front
      # of spotify_bedtime_volume, so the music only started tapering ~77s after
      # getting into bed.
      - parallel:
          - action: script.turn_on
            target:
              entity_id: script.night_tv_mode_switches
          - action: script.turn_on
            target:
              entity_id: script.spotify_bedtime_volume
          - action: script.apply_owner_suite_inovelli_led_policy
            data:
              policy: dark
      # - delay: "00:10:00"
      # - action: switch.turn_on
      #   entity_id: switch.sleep_mode

  - id: bedroom_music_select_playlist
    alias: bedroom_music_select_playlist
    trace:
      stored_traces: 50
    trigger:
      # - platform: event
      #   event_type: zha_event
      #   event_data:
@@PRIVATE:music_annotation_004@@
      #     command: "flip"
      - trigger: state
        entity_id: sensor.owner_suite_cube_action_to_side
        not_to:
          - "None"
          - "unknown"
          - "unavailable"
    action:
      - action: notify.all
        data:
          message: >-
            {{ "script.bedroom_playlist_" + (trigger.to_state.state | string) }}
      - action: script.turn_on
        target:
          entity_id: >-
            {{ "script.bedroom_playlist_" + (trigger.to_state.state | string) }}

  - id: bedroom_music_skip_track
    alias: bedroom_music_skip_track
    trace:
      stored_traces: 50
    trigger:
      # - platform: event
      #   event_type: zha_event
      #   event_data:
@@PRIVATE:music_annotation_005@@
      #     command: "slide"
      - trigger: state
        entity_id: sensor.owner_suite_cube_action
        to: "slide"
    action:
      - action: media_player.media_next_track
        target:
          entity_id: media_player.ma_bedroom

  - id: bedroom_music_shuffle
    alias: bedroom_music_shuffle
    trace:
      stored_traces: 50
    trigger:
      # - platform: event
      #   event_type: zha_event
      #   event_data:
@@PRIVATE:music_annotation_006@@
      #     command: "shake"
      - trigger: state
        entity_id: sensor.owner_suite_cube_action
        to: "shake"
    action:
      - action: media_player.shuffle_set
        target:
          entity_id: media_player.ma_bedroom
        data:
          shuffle: >-
            {{ not (state_attr('media_player.ma_bedroom', 'shuffle')) }}

  - id: den_sonos_control_actions
    alias: den_sonos_control_actions
    trace:
      stored_traces: 50
    trigger:
      - trigger: state
        entity_id:
          - sensor.den_sonos_controls_action
        to: "toggle"
        id: toggle_play_pause
      - trigger: state
        entity_id:
          - sensor.den_sonos_controls_action
        to: "play_pause"
        id: play_pause
      - trigger: state
        entity_id:
          - sensor.den_sonos_controls_action
        to: "track_next"
        id: track_next
      - trigger: state
        entity_id:
          - sensor.den_sonos_controls_action
        to: "track_previous"
        id: track_previous
      - trigger: state
        entity_id:
          - sensor.den_sonos_controls_action
        to: "volume_up"
        id: volume_up
      - trigger: state
        entity_id:
          - sensor.den_sonos_controls_action
        to: "volume_up_hold"
        id: volume_up_hold
      - trigger: state
        entity_id:
          - sensor.den_sonos_controls_action
        to: "volume_down"
        id: volume_down
      - trigger: state
        entity_id:
          - sensor.den_sonos_controls_action
        to: "volume_down_hold"
        id: volume_down_hold
      # TODO Use Dots for shuffle and repeat
    action:
      - choose:
          - conditions:
              - condition: or
                conditions:
                  - condition: trigger
                    id: toggle_play_pause
                  - condition: trigger
                    id: play_pause
            sequence:
              - action: media_player.media_play_pause
                target:
                  entity_id: media_player.ma_den
          - conditions:
              - condition: trigger
                id: track_next
            sequence:
              - action: media_player.media_next_track
                target:
                  entity_id: media_player.ma_den
          - conditions:
              - condition: trigger
                id: track_previous
            sequence:
              - action: media_player.media_previous_track
                target:
                  entity_id: media_player.ma_den
          - conditions:
              - condition: or
                conditions:
                  - condition: trigger
                    id: volume_up
                  - condition: trigger
                    id: volume_up_hold
            sequence:
              - action: media_player.volume_up
                target:
                  entity_id: media_player.ma_den
          - conditions:
              - condition: or
                conditions:
                  - condition: trigger
                    id: volume_down
                  - condition: trigger
                    id: volume_down_hold
            sequence:
              - action: media_player.volume_down
                target:
                  entity_id: media_player.ma_den

  - id: play_music_in_bathroom_via_nfc_tap
    alias: play_music_in_bathroom_via_nfc_tap
    trace:
      stored_traces: 50
    trigger:
      - trigger: event
        event_type: tag_scanned
        event_data:
          device_id: @@PRIVATE:media_nfc_device_id@@
          tag_id: @@PRIVATE:media_nfc_tag_id@@
    action:
      - action: media_player.join
        data:
          group_members:
            - media_player.ma_bathroom
        target:
          entity_id: media_player.ma_bedroom

  - id: play_music_in_bathroom_when_up
    alias: play_music_in_bathroom_when_up
    trace:
      stored_traces: 50
    mode: single
    trigger:
      - trigger: state
        entity_id:
          - binary_sensor.owner_suite_bathroom_room_occupancy
        to: "on"
    condition:
      - alias: "Not in Bed"
        condition: state
        entity_id: binary_sensor.bayesian_bed_occupancy
        # entity_id: input_boolean.chatgpt_bed_occupied
        state: "off"
      - alias: "morning routine already started"
        condition: state
        entity_id: input_boolean.morning_routine
        state: "off"
      - alias: >-
          Only the real alarm's wake window starts music — a bathroom trip
          before the alarm (e.g. waking early and going back to bed) must not
          trigger it
        condition: template
        value_template: >-
          {# input_datetime.weekday_alarm/weekend_alarm are has_date: false,
@@PRIVATE:music_annotation_007@@
@@PRIVATE:music_annotation_008@@
@@PRIVATE:music_annotation_009@@
@@PRIVATE:music_annotation_010@@
@@PRIVATE:music_annotation_011@@
@@PRIVATE:music_annotation_012@@
@@PRIVATE:music_annotation_013@@
             morning_activity, #939). #}
          {# alarm_wake_up requires binary_sensor.workday_sensor to be
@@PRIVATE:music_annotation_014@@
@@PRIVATE:music_annotation_015@@
@@PRIVATE:music_annotation_016@@
@@PRIVATE:music_annotation_017@@
@@PRIVATE:music_annotation_018@@
@@PRIVATE:music_annotation_019@@
@@PRIVATE:music_annotation_020@@
@@PRIVATE:music_annotation_021@@
             (Codex P2 follow-up on #972). #}
          {% set workday_sensor_state = states('binary_sensor.workday_sensor') %}
          {% if workday_sensor_state == 'on' %}
            {# A special meeting can wake the resident earlier than the
@@PRIVATE:music_annotation_022@@
@@PRIVATE:music_annotation_023@@
@@PRIVATE:music_annotation_024@@
@@PRIVATE:music_annotation_025@@
@@PRIVATE:music_annotation_026@@
               rejected for being before the weekday alarm (Codex P2). #}
            {% set candidates = [
                 state_attr('input_datetime.weekday_alarm', 'timestamp')
                   if is_state('input_boolean.weekday_alarm_on', 'on') else none,
                 state_attr('input_datetime.next_work_meeting', 'timestamp')
                   if is_state('input_boolean.special_meeting', 'on') else none
               ] | select('number') | reject('equalto', 0) | list %}
            {% set alarm_enabled = candidates | length > 0 %}
            {% set alarm_seconds_since_midnight = candidates | min if candidates else 0 %}
          {% elif workday_sensor_state == 'off' %}
            {% set alarm_enabled = is_state('input_boolean.weekend_alarm_on', 'on') %}
            {% set alarm_seconds_since_midnight = state_attr('input_datetime.weekend_alarm', 'timestamp') | float(0) %}
          {% else %}
            {% set alarm_enabled = false %}
            {% set alarm_seconds_since_midnight = 0 %}
          {% endif %}
          {% set now_seconds_since_midnight = now().hour * 3600 + now().minute * 60 + now().second %}
          {% set wake_window_seconds = 90 * 60 %}
          {# alarm_wake_up's meeting-alarm branch turns special_meeting off
@@PRIVATE:music_annotation_027@@
@@PRIVATE:music_annotation_028@@
@@PRIVATE:music_annotation_029@@
@@PRIVATE:music_annotation_030@@
@@PRIVATE:music_annotation_031@@
@@PRIVATE:music_annotation_032@@
@@PRIVATE:music_annotation_033@@
@@PRIVATE:music_annotation_034@@
@@PRIVATE:music_annotation_035@@
@@PRIVATE:music_annotation_036@@
@@PRIVATE:music_annotation_037@@
@@PRIVATE:music_annotation_038@@
@@PRIVATE:music_annotation_039@@
@@PRIVATE:music_annotation_040@@
@@PRIVATE:music_annotation_041@@
@@PRIVATE:music_annotation_042@@
@@PRIVATE:music_annotation_043@@
@@PRIVATE:music_annotation_044@@
@@PRIVATE:music_annotation_045@@
@@PRIVATE:music_annotation_046@@
@@PRIVATE:music_annotation_047@@
@@PRIVATE:music_annotation_048@@
@@PRIVATE:music_annotation_049@@
             timestamp is sufficient on its own and needs no such latch. #}
          {% set alarm_firing_recently =
               (as_timestamp(now()) - (state_attr('input_datetime.wakeup_alarm_fired_at', 'timestamp') | float(0))) <= wake_window_seconds %}
          {{ alarm_firing_recently
             or (alarm_enabled and alarm_seconds_since_midnight > 0
             and now_seconds_since_midnight >= alarm_seconds_since_midnight
             and now_seconds_since_midnight <= (alarm_seconds_since_midnight + wake_window_seconds)) }}
    action:
      - variables:
          bathroom_was_playing: "{{ is_state('media_player.ma_bathroom', 'playing') }}"
          bathroom_volume_above_min: "{{ state_attr('media_player.ma_bathroom', 'volume_level') | float(0) > 0.1 }}"
          group_members: >-
            {{ ['media_player.ma_bedroom', 'media_player.ma_bathroom']
               if is_state('input_boolean.guest_mode', 'on')
               else ['media_player.ma_bedroom', 'media_player.ma_bathroom',
                     'media_player.ma_office', 'media_player.ma_den'] }}
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.morning_routine
      - if:
          - condition: state
            entity_id: binary_sensor.workday_sensor
            state: "on"
        then:
          - action: script.apply_owner_suite_inovelli_led_policy
            data:
              policy: day
              scope: bathroom
          - action: script.turn_on
            target:
              entity_id: script.day_mode_switches_office_guest_room
      - choose:
          # Bathroom already had audible playback (alarm ramped up). Switch to Spotify and
          # ramp non-office members back to the calibrated 0.25 alarm peak.
          - conditions:
              - condition: template
                value_template: "{{ bathroom_was_playing and bathroom_volume_above_min }}"
            sequence:
              - action: script.spotify_wake_up
                data:
                  playback_entity_id: media_player.ma_group_everywhere
              - alias: "Ramp non-office group members back to the 0.25 alarm peak"
                repeat:
                  sequence:
                    - action: media_player.volume_set
                      continue_on_error: true
                      target:
                        entity_id: "{{ group_members | reject('eq', 'media_player.ma_office') | list }}"
                      data:
                        volume_level: "{{ [0.05 + (0.01 * repeat.index), 0.25] | min }}"
                    - alias: "Office capped at 10% — bedroom wake-up should not disturb work-in-progress"
                      continue_on_error: true
                      action: media_player.volume_set
                      target:
                        entity_id: media_player.ma_office
                      data:
                        volume_level: "{{ [0.05 + (0.01 * repeat.index), 0.07] | min }}"
                    - delay:
                        seconds: "{{ (1/(tan((repeat.index + 5)/60))) | round(0, 'ceil', 5) }}"
                  until: "{{ repeat.index == 20 }}"
        default:
          # Nothing is playing in the bathroom yet, so ease all members up gently.
          - alias: "Prime all members to safe starting volume"
            action: media_player.volume_set
            continue_on_error: true
            target:
              entity_id: "{{ group_members }}"
            data:
              volume_level: 0.05
          - action: script.spotify_wake_up
            data:
              playback_entity_id: media_player.ma_group_everywhere
          - alias: "Ramp non-office group members to the 0.25 alarm peak"
            repeat:
              sequence:
                - alias: "Increase Volume by 0.01"
                  action: media_player.volume_set
                  continue_on_error: true
                  target:
                    entity_id: "{{ group_members | reject('eq', 'media_player.ma_office') | list }}"
                  data:
                    volume_level: "{{ [0.01 * repeat.index, 0.25] | min }}"
                - alias: "Office capped at 7% — bedroom wake-up should not disturb work-in-progress"
                  continue_on_error: true
                  action: media_player.volume_set
                  target:
                    entity_id: media_player.ma_office
                  data:
                    volume_level: "{{ [0.01 * repeat.index, 0.07] | min }}"
                - delay:
                    # As time passes, the delay gets smaller and smaller. 60, 30s, 20s, 15s, 12s,..., 2s
                    seconds: "{{ (1/(tan(repeat.index/60))) | round(0, 'ceil', 5)}}"
              until: "{{ repeat.index == 25 }}"

  - id: recover_stuck_morning_audio_scripts
    alias: recover_stuck_morning_audio_scripts
    trace:
      stored_traces: 50
    mode: single
    trigger:
      - trigger: state
        entity_id: script.music_assistant_prepare_bedroom_group
        to: "on"
        for:
          minutes: 1
      - trigger: state
        entity_id:
          - script.spotify_wake_up
          - script.music_assistant_radio_wake_up
        to: "on"
        for:
          minutes: 12
    action:
      - action: logbook.log
        data:
          entity_id: "{{ trigger.entity_id }}"
          domain: script
          name: Morning audio recovery
          message: "Stopped a stalled morning audio script and cleared the wake-up latch."
      - action: script.turn_off
        continue_on_error: true
        target:
          entity_id:
            - script.music_assistant_prepare_bedroom_group
            - script.music_assistant_radio_wake_up
            - script.spotify_wake_up
      - action: input_boolean.turn_off
        continue_on_error: true
        target:
          entity_id: input_boolean.morning_routine

  - id: restart_sonos_unavailable
    alias: restart_sonos_unavailable
    description: >-
      Bedroom-suite Sonos players occasionally drop to "unavailable" — either an
      integration-level flap (recoverable by reloading the player's config entry)
      or a hardware fault such as a red status LED, which only a physical
      power-cycle can clear. After 30 min unavailable, try a cheap config-entry
      reload first; if the player is still unavailable a minute later, notify so a
      human can power-cycle it. The previous blanket homeassistant.restart was
      removed: it disrupts the whole house and, for a hardware fault, cannot
      recover the speaker (see #839).
    trace:
      stored_traces: 50
    mode: parallel
    max: 4
    trigger:
      - trigger: state
        entity_id:
          - media_player.ma_bedroom
          - media_player.ma_bathroom
          - media_player.ma_office
          - media_player.ma_den
        to: "unavailable"
        for:
          minutes: 30
    action:
      - alias: "Cheap first attempt — reload the player's config entry"
        continue_on_error: true
        action: homeassistant.reload_config_entry
        target:
          entity_id: "{{ trigger.entity_id }}"
      - alias: "Give the reload time to bring the player back"
        delay:
          minutes: 1
      - alias: "Still unavailable after reload — a human power-cycle is required"
        if:
          - condition: template
            value_template: "{{ is_state(trigger.entity_id, 'unavailable') }}"
        then:
          - action: notify.all
            continue_on_error: true
            data:
              title: "Sonos needs attention"
              message: >-
                {{ state_attr(trigger.entity_id, 'friendly_name') or trigger.entity_id }}
                has been unavailable for 30+ minutes and a config-entry reload did not
                recover it. Check the speaker for a red status LED — it likely needs a
                physical power-cycle (unplug ~10s, plug back in).

  - id: bedtime_music_homekit_trigger
    alias: "Bedtime Music — HomeKit trigger"
    description: >-
      Exposes a momentary switch to HomeKit/Siri. Turning on input_boolean.bedtime_music
      fires script.spotify_bedtime non-blocking, then immediately resets the boolean so
      HomeKit always sees it as off (stateless trigger pattern).
    mode: single
    trace:
      stored_traces: 50
    trigger:
      - trigger: state
        entity_id: input_boolean.bedtime_music
        to: "on"
    action:
      - action: script.turn_on
        target:
          entity_id: script.spotify_bedtime
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.bedtime_music


