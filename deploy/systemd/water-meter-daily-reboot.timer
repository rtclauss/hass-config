[Unit]
Description=Daily preventive reboot for the water meter Pi

[Timer]
# 3am local: quietest household-usage window, and far from the reader's own
# 20-minute polling cadence ever lining up with a boot in a way that matters
# (the reader is a one-shot systemd-timer job, not a long-running process,
# so a reboot mid-cycle just means one skipped/late reading, not corruption -
# see water_meter/reader.py's history_limit rotation, which tolerates gaps).
# Not a fix for anything specific - the camera-stuck watchdog
# (water_meter/watchdog.py) already self-heals that failure mode without
# needing a scheduled reboot. This is just cheap preventive hygiene for an
# always-on embedded box (clears any slow memory/fd leaks, refreshes the
# DHCP lease, applies any pending kernel/driver updates that need a reboot).
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=5min
# Deliberately NOT Persistent=true. This Pi has no battery-backed RTC, so
# every boot starts with a stale pre-NTP clock (observed: defaults to
# 2026-07-27, the firmware build date) until NTP corrects it. Persistent=true
# makes systemd fire an immediate "catch-up" run if it thinks a scheduled
# occurrence was missed - and it always thinks that here, because the stale
# post-boot clock makes the last-run timestamp look like it's "in the
# future". That caused a real incident on 2026-09-23: the Pi rebooted every
# ~50 seconds in a tight loop (reboot -> stale clock -> timer "catches up" ->
# reboot -> repeat) badly enough that it required a manual power cycle to
# break. Skipping one day's reboot on the rare occasion the Pi is off at 3am
# is a fine trade-off for never risking this again.

[Install]
WantedBy=timers.target
